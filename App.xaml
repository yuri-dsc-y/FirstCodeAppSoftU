<Application x:Class="WeightTracker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#237A57" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E8F3EC" />
    <SolidColorBrush x:Key="WindowBrush" Color="#F6F8F4" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextBrush" Color="#202A24" />
    <SolidColorBrush x:Key="MutedBrush" Color="#728078" />
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#33879086" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="7" />
      <Setter Property="Margin" Value="3" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="5" />
      <Setter Property="Margin" Value="3" />
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="AlternatingRowBackground" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
  </Application.Resources>
</Application>