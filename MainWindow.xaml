<Window x:Class="WeightTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Weight Tracker" Width="1280" Height="900" MinWidth="980" MinHeight="700"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
  <Window.Resources>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="14,11" />
      <Setter Property="Margin" Value="0,3" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="#23879086" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="CardLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="208" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="#22879086" BorderThickness="0,0,1,0">
      <DockPanel Margin="17,24">
        <TextBlock DockPanel.Dock="Top" Text="WEIGHT&#10;TRACKER" Foreground="{DynamicResource AccentBrush}"
                   FontSize="18" FontWeight="Bold" Margin="4,0,0,30" />
        <TextBlock DockPanel.Dock="Bottom" Text="OFFLINE BY DESIGN" Foreground="{DynamicResource AccentBrush}"
                   FontSize="10" FontWeight="Bold" Margin="4,0,0,0" />
        <StackPanel>
          <Button Style="{StaticResource NavButton}" Content="Overview" Click="Overview_Click" />
          <Button Style="{StaticResource NavButton}" Content="History" Click="History_Click" />
          <Button Style="{StaticResource NavButton}" Content="Weekly averages" Click="Weekly_Click" />
          <Button Style="{StaticResource NavButton}" Content="Settings &amp; data" Click="Settings_Click" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="27,22,27,22">
      <Grid x:Name="OverviewPage">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Background="{DynamicResource AccentBrush}" CornerRadius="7" Padding="21" Margin="0,0,0,18">
              <StackPanel>
                <TextBlock x:Name="QuoteText" Text="A record of your own progress, one day at a time." Foreground="White"
                           FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="QuoteAttribution" Text="No verified quotations bundled" Foreground="#DDFFFFFF" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
            <DockPanel Margin="0,0,0,13">
              <TextBlock Text="Your progress" FontSize="25" FontWeight="SemiBold" />
              <TextBlock x:Name="TodayLabel" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}"
                         VerticalAlignment="Center" HorizontalAlignment="Right" />
            </DockPanel>
            <UniformGrid Columns="3" Margin="0,0,0,15">
              <Border Style="{StaticResource Card}" Margin="0,0,7,7"><StackPanel><TextBlock Text="Latest weight" Style="{StaticResource CardLabel}"/><TextBlock x:Name="LatestValue" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><TextBlock x:Name="LatestDetail" Style="{StaticResource CardLabel}"/></StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="7,0,7,7"><StackPanel><TextBlock Text="Change vs previous" Style="{StaticResource CardLabel}"/><TextBlock x:Name="PreviousChange" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><TextBlock x:Name="PreviousDetail" Style="{StaticResource CardLabel}"/></StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="7,0,0,7"><StackPanel><TextBlock Text="Selected-period change" Style="{StaticResource CardLabel}"/><TextBlock x:Name="PeriodChange" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><TextBlock x:Name="PeriodDetail" Style="{StaticResource CardLabel}"/></StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="0,7,7,0"><StackPanel><TextBlock Text="This week" Style="{StaticResource CardLabel}"/><TextBlock x:Name="CurrentAverage" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><TextBlock x:Name="CurrentAverageDetail" Style="{StaticResource CardLabel}"/></StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="7,7,7,0"><StackPanel><TextBlock Text="Previous week" Style="{StaticResource CardLabel}"/><TextBlock x:Name="PriorAverage" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><TextBlock x:Name="PriorAverageDetail" Style="{StaticResource CardLabel}"/></StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="7,7,0,0"><StackPanel><TextBlock Text="Measurements" Style="{StaticResource CardLabel}"/><TextBlock x:Name="CountValue" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Recorded entries" Style="{StaticResource CardLabel}"/></StackPanel></Border>
            </UniformGrid>
            <UniformGrid Columns="2" Margin="0,0,0,15">
              <Border Style="{StaticResource Card}" Margin="0,0,7,0"><StackPanel><TextBlock Text="Highest recorded" Style="{StaticResource CardLabel}"/><TextBlock x:Name="HighestValue" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/></StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="7,0,0,0"><StackPanel><TextBlock Text="Lowest recorded" Style="{StaticResource CardLabel}"/><TextBlock x:Name="LowestValue" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/></StackPanel></Border>
            </UniformGrid>
            <Grid MinHeight="370" Margin="0,0,0,15">
              <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Add a measurement" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                  <TextBlock Text="Date" Style="{StaticResource CardLabel}"/><DatePicker x:Name="EntryDate" Margin="0,3,0,8" />
                  <TextBlock Text="Weight" Style="{StaticResource CardLabel}"/><TextBox x:Name="EntryWeight" Margin="0,3,0,8" />
                  <TextBlock Text="Optional note" Style="{StaticResource CardLabel}"/><TextBox x:Name="EntryNote" Margin="0,3,0,12" MaxLength="500" />
                  <Button Content="Save measurement" Background="{DynamicResource AccentBrush}" Foreground="White" Click="SaveMeasurement_Click" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Card}" Padding="15">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Weight trend" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ComboBox x:Name="RangeSelector" Width="125" Margin="15,0,0,0" SelectionChanged="Range_Changed">
                      <ComboBoxItem Content="All time" IsSelected="True"/><ComboBoxItem Content="7 days"/><ComboBoxItem Content="30 days"/>
                      <ComboBoxItem Content="90 days"/><ComboBoxItem Content="6 months"/><ComboBoxItem Content="12 months"/><ComboBoxItem Content="Custom"/>
                    </ComboBox>
                    <DatePicker x:Name="RangeStart" Width="130" Visibility="Collapsed" SelectedDateChanged="Range_Changed" />
                    <DatePicker x:Name="RangeEnd" Width="130" Visibility="Collapsed" SelectedDateChanged="Range_Changed" />
                  </StackPanel>
                  <Canvas x:Name="ChartCanvas" MinHeight="300" SizeChanged="Chart_SizeChanged" />
                </DockPanel>
              </Border>
            </Grid>
            <DockPanel Margin="0,0,0,7">
              <TextBlock Text="Recent records" FontSize="16" FontWeight="SemiBold" />
              <Button Content="View history" DockPanel.Dock="Right" Padding="10,4" Click="History_Click" />
            </DockPanel>
            <DataGrid x:Name="RecentGrid" Height="155" Margin="0,0,0,10">
              <DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding DisplayDate}"/><DataGridTextColumn Header="Weight" Binding="{Binding DisplayWeight}"/><DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/></DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <Grid x:Name="HistoryPage" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
          <TextBlock Text="Measurement history" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBox x:Name="HistoryFilter" Width="230" DockPanel.Dock="Right" ToolTip="Filter by date or note" TextChanged="HistoryFilter_Changed" />
        </DockPanel>
        <DataGrid x:Name="HistoryGrid" Grid.Row="1" SelectionMode="Single" MouseDoubleClick="EditSelected_Click">
          <DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding DisplayDate}" SortMemberPath="Day"/><DataGridTextColumn Header="Weight" Binding="{Binding DisplayWeight}" SortMemberPath="WeightKg"/><DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/></DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
          <Button Content="Edit selected" Click="EditSelected_Click"/><Button Content="Delete selected" Click="DeleteSelected_Click"/>
        </StackPanel>
      </Grid>
      <Grid x:Name="WeeklyPage" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Weekly averages" FontSize="25" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Text="Monday through Sunday. Only recorded measurements contribute." Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,14" />
        <DataGrid x:Name="WeeklyGrid" Grid.Row="2">
          <DataGrid.Columns><DataGridTextColumn Header="Week beginning" Binding="{Binding DisplayMonday}"/><DataGridTextColumn Header="Week ending" Binding="{Binding DisplaySunday}"/><DataGridTextColumn Header="Average" Binding="{Binding DisplayAverage}"/><DataGridTextColumn Header="Measurements" Binding="{Binding MeasurementCount}"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/></DataGrid.Columns>
        </DataGrid>
      </Grid>
      <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="780" HorizontalAlignment="Left">
          <TextBlock Text="Settings &amp; data" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,16" />
          <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold" />
          <Grid Margin="0,8,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="Mode" VerticalAlignment="Center"/><ComboBox x:Name="AppearanceSelector" Grid.Column="1" SelectionChanged="Settings_Changed"><ComboBoxItem Content="Light" IsSelected="True"/><ComboBoxItem Content="Dark"/></ComboBox>
            <TextBlock Grid.Row="1" Text="Color scheme" VerticalAlignment="Center"/><ComboBox x:Name="SchemeSelector" Grid.Row="1" Grid.Column="1" SelectionChanged="Settings_Changed"><ComboBoxItem Content="Forest Green" IsSelected="True"/><ComboBoxItem Content="Ocean Blue"/><ComboBoxItem Content="Midnight Violet"/><ComboBoxItem Content="Warm Amber"/><ComboBoxItem Content="Monochrome"/></ComboBox>
            <TextBlock Grid.Row="2" Text="Weight unit" VerticalAlignment="Center"/><ComboBox x:Name="UnitSelector" Grid.Row="2" Grid.Column="1" SelectionChanged="Settings_Changed"><ComboBoxItem Content="kg" IsSelected="True"/><ComboBoxItem Content="lb"/></ComboBox>
            <TextBlock Grid.Row="3" Text="Decimal places" VerticalAlignment="Center"/><ComboBox x:Name="PrecisionSelector" Grid.Row="3" Grid.Column="1" SelectionChanged="Settings_Changed"><ComboBoxItem Content="0"/><ComboBoxItem Content="1" IsSelected="True"/><ComboBoxItem Content="2"/></ComboBox>
            <TextBlock Grid.Row="4" Text="Date format" VerticalAlignment="Center"/><ComboBox x:Name="DateFormatSelector" Grid.Row="4" Grid.Column="1" SelectionChanged="Settings_Changed"><ComboBoxItem Content="yyyy-MM-dd" IsSelected="True"/><ComboBoxItem Content="MM/dd/yyyy"/><ComboBoxItem Content="dd/MM/yyyy"/></ComboBox>
          </Grid>
          <TextBlock Text="Local data" FontSize="16" FontWeight="SemiBold" />
          <TextBlock x:Name="DataPathLabel" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,10" />
          <WrapPanel>
            <Button Content="Open data folder" Click="OpenDataFolder_Click"/><Button Content="Backup database" Click="Backup_Click"/>
            <Button Content="Restore database" Click="Restore_Click"/><Button Content="Export CSV" Click="ExportCsv_Click"/>
            <Button Content="Export JSON" Click="ExportJson_Click"/><Button Content="Import JSON" Click="ImportJson_Click"/>
            <Button Content="Delete all records" Click="DeleteAll_Click" />
          </WrapPanel>
          <TextBlock Text="Offline by design. No network features are included. Deleting the application folder does not delete copies of exported backups." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,18,0,0" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>